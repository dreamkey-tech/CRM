generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String?
  passwordHash String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles                 UserRole[]
  sessions              Session[]
  owners                Owner[]                @relation("OwnerPrimaryPartner")
  ownersCreated         Owner[]                @relation("OwnerCreator")
  brokers               Broker[]               @relation("BrokerPrimaryPartner")
  propertiesAdded       Property[]             @relation("PropertySourcePartner")
  propertyAuditLogs     PropertyAuditLog[]     @relation("PropertyAuditPartner")
  propertyFilterPresets PropertyFilterPreset[]
  clientsCreated        Client[]                    @relation("ClientCreator")
  clientAssignments     ClientPartnerAssignment[]   @relation("ClientAssignedPartner")
  clientAssignmentsMade ClientPartnerAssignment[]   @relation("ClientAssignmentCreator")
  clientShortlistsAdded  ClientShortlistedProperty[] @relation("ClientShortlistCreator")
  clientSharesCreated   ClientPropertyShare[]       @relation("ClientShareCreator")
  clientDocumentsAdded  ClientDocument[]            @relation("ClientDocumentUploader")
  auditLogs             AuditLog[]                  @relation("UserAuditLogs")
  notifications         Notification[]              @relation("UserNotifications")
  tasksCreated          Task[]                      @relation("TaskCreator")
  tasksCompleted        Task[]                      @relation("TaskCompleter")
  taskAssignments       TaskAssignee[]              @relation("TaskAssigneeUser")
  partnerTransactions   FinanceTransaction[]        @relation("TransactionPartner")
  createdTransactions   FinanceTransaction[]        @relation("TransactionCreator")
  salaryDisbursementsReceived SalaryDisbursement[]   @relation("SalaryEmployee")
  salaryDisbursementsMade     SalaryDisbursement[]   @relation("SalaryDisburser")
  forecastsCreated      UpcomingFinanceItem[]       @relation("ForecastCreator")
  partnerForecasts      UpcomingFinanceItem[]       @relation("ForecastPartner")
  duesAdvancesAsEmployee DueAndAdvanceRecord[]      @relation("DueAdvanceEmployee")
  duesAdvancesCreated   DueAndAdvanceRecord[]       @relation("DueAdvanceCreator")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique // e.g. "leads:read", "leads:create", "deals:delete", "users:manage", "*:*"
  category    String           // e.g. "LEADS", "DEALS", "SETTINGS", "USERS", "ALL"
  description String?
  createdAt   DateTime         @default(now())

  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model WebsiteUser {
  id               String               @id @default(uuid())
  email            String               @unique
  name             String?
  emailVerified    Boolean              @default(false)
  passwordHash     String?              // Nullable for users registered solely via Google
  authProvider     String               @default("EMAIL") // "EMAIL" | "GOOGLE" | "BOTH"
  lastAuthProvider String?              @default("EMAIL")
  googleId         String?
  isActive         Boolean              @default(true)
  loginCount       Int                  @default(0)
  lastLoginAt      DateTime?
  lastActiveAt     DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  sessions         WebsiteUserSession[]
  propertyClicks   WebsitePropertyClick[]

  @@index([googleId])
  @@map("website_users")
}

model WebsiteUserSession {
  id         String      @id @default(uuid())
  userId     String
  token      String      @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime    @default(now())
  lastUsedAt DateTime    @default(now())

  user       WebsiteUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("website_user_sessions")
}

model WebsiteUserOtp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  purpose   String   // "LOGIN" | "PASSWORD_RESET"
  attempts  Int      @default(0)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
  @@map("website_user_otps")
}

model WebsiteEnquiry {
  id                   String   @id @default(uuid())
  fullName             String
  mobileNo             String
  email                String
  propertyType         String
  preferredLocation    String
  estimatedBudgetBand  String
  specificRequirements String?
  status               String   @default("NEW") // "NEW" | "IN_PROGRESS" | "CONTACTED" | "RESOLVED" | "CLOSED"
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([email])
  @@index([mobileNo])
  @@index([status])
  @@map("website_enquiries")
}

enum BrokerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Broker {
  id                      String       @id @default(uuid())
  name                    String
  phone                   String?
  email                   String?
  whatsappNumber          String?
  areaOfOperation         String?
  primaryContactPartnerId String?
  minDealValue            Float?       // Minimum deal value typically handled
  societyExpertise        String[]     @default([]) // List of societies or localities where broker has strong connections
  status                  BrokerStatus @default(ACTIVE)
  notes                   String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  primaryContactPartner   User?        @relation("BrokerPrimaryPartner", fields: [primaryContactPartnerId], references: [id], onDelete: SetNull)
  properties              Property[]   @relation("BrokerProperties")
  duesAndAdvances         DueAndAdvanceRecord[]

  @@index([status])
  @@index([phone])
  @@index([email])
  @@index([primaryContactPartnerId])
  @@map("brokers")
}

enum OwnerStatus {
  ACTIVE
  INACTIVE
}

model Owner {
  id                      String      @id @default(uuid())
  name                    String
  phone                   String
  email                   String?
  whatsappNumber          String?
  address                 String?
  primaryContactPartnerId String?
  createdById             String
  notes                   String?
  status                  OwnerStatus @default(ACTIVE)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  primaryContactPartner User?      @relation("OwnerPrimaryPartner", fields: [primaryContactPartnerId], references: [id], onDelete: SetNull)
  createdBy             User       @relation("OwnerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  properties            Property[] @relation("OwnerProperties")
  duesAndAdvances       DueAndAdvanceRecord[]

  @@index([phone])
  @@index([status])
  @@index([primaryContactPartnerId])
  @@index([createdById])
  @@map("owners")
}

// ==========================================
// CLIENT DIRECTORY (V1 — no lead pipeline yet)
// ==========================================

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum ClientShortlistStatus {
  SHORTLISTED
  SHARED
  VISITED
  INTERESTED
  NOT_INTERESTED
}

enum ClientShareChannel {
  WHATSAPP
  EMAIL
  LINK
}

enum ClientShareStatus {
  PREPARED
  COMPOSER_OPENED
  SENT_CONFIRMED
}

enum ClientDocumentCategory {
  AADHAAR
  PAYMENT_RECEIPT
  CLIENT_DOCUMENT
  PCC_APPLICATION
  CERTIFICATE
  KYC
}

model Client {
  id             String       @id @default(uuid())
  name           String
  phone          String
  email          String?
  whatsappNumber String?
  address        String?
  notes          String?
  status         ClientStatus @default(ACTIVE)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  createdBy             User                        @relation("ClientCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedPartners      ClientPartnerAssignment[]
  shortlistedProperties ClientShortlistedProperty[]
  documents             ClientDocument[]
  tasks                 Task[]                      @relation("ClientTasks")
  financeTransactions   FinanceTransaction[]
  upcomingFinanceItems  UpcomingFinanceItem[]
  duesAndAdvances       DueAndAdvanceRecord[]

  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@map("clients")
}

model ClientPartnerAssignment {
  clientId     String
  partnerId    String
  assignedById String
  assignedAt   DateTime @default(now())

  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  partner    User   @relation("ClientAssignedPartner", fields: [partnerId], references: [id], onDelete: Restrict)
  assignedBy User   @relation("ClientAssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)

  @@id([clientId, partnerId])
  @@index([partnerId, clientId])
  @@index([assignedById])
  @@map("client_partner_assignments")
}

model ClientShortlistedProperty {
  id         String                @id @default(uuid())
  clientId   String
  propertyId String
  status     ClientShortlistStatus @default(SHORTLISTED)
  notes      String?
  addedById  String
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  client   Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  property Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  addedBy  User                  @relation("ClientShortlistCreator", fields: [addedById], references: [id], onDelete: Restrict)
  shares   ClientPropertyShare[]

  @@unique([clientId, propertyId])
  @@unique([id, clientId, propertyId])
  @@index([propertyId])
  @@index([clientId, status])
  @@index([addedById])
  @@map("client_shortlisted_properties")
}

model ClientPropertyShare {
  id                    String             @id @default(uuid())
  shortlistedPropertyId String
  clientId              String
  propertyId            String
  // Generate a cryptographically random token on the server, never from a client ID.
  publicToken           String             @unique
  channel               ClientShareChannel
  status                ClientShareStatus  @default(PREPARED)
  recipient             String?
  subject               String?
  message               String
  // Whitelisted public listing fields only; never serialize a full Property/Client.
  propertySnapshot      Json
  // Historical selection metadata only, without URLs; public pages use live media relations.
  selectedMediaSnapshot Json
  createdById           String
  composerOpenedAt      DateTime?
  sentConfirmedAt       DateTime?
  expiresAt             DateTime?
  revokedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  shortlistedProperty ClientShortlistedProperty  @relation(fields: [shortlistedPropertyId, clientId, propertyId], references: [id, clientId, propertyId], onDelete: Restrict)
  createdBy           User                       @relation("ClientShareCreator", fields: [createdById], references: [id], onDelete: Restrict)
  selectedMedia       ClientPropertyShareMedia[]

  @@unique([id, propertyId])
  @@index([clientId, createdAt])
  @@index([propertyId])
  @@index([shortlistedPropertyId, clientId, propertyId])
  @@index([createdById])
  @@map("client_property_shares")
}

model ClientPropertyShareMedia {
  shareId         String
  propertyMediaId String
  propertyId      String
  order           Int    @default(0)

  // Composite references prevent selecting media from a different property.
  share ClientPropertyShare @relation(fields: [shareId, propertyId], references: [id, propertyId], onDelete: Cascade)
  media PropertyMedia       @relation(fields: [propertyMediaId, propertyId], references: [id, propertyId], onDelete: Cascade)

  @@id([shareId, propertyMediaId])
  @@index([shareId, propertyId])
  @@index([propertyMediaId, propertyId])
  @@map("client_property_share_media")
}

model ClientDocument {
  id           String                 @id @default(uuid())
  clientId     String
  category     ClientDocumentCategory
  title        String?
  originalName String
  // Store in a private bucket. A prefix within the public property bucket is not private.
  key          String                 @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  client     Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  uploadedBy User   @relation("ClientDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([clientId, category])
  @@index([uploadedById])
  @@map("client_documents")
}

// ==========================================
// PROPERTY & MEDIA SCHEMA
// ==========================================

enum PropertyType {
  FLAT
  LAND
  WAREHOUSE
  COMMERCIAL
  OTHER
}

enum PropertyPricingType {
  SALE
  RENT
}

enum PropertyListingStatus {
  AVAILABLE
  UNDER_NEGOTIATION
  TOKEN_PAID
  DEAL_DONE
  RENTED_OUT
  SOLD
  UPCOMING
}

enum PropertyAccessType {
  DIRECT
  BROKER // "+1 Broker"
}

enum PropertyMediaCategory {
  PHOTOGRAPH
  VIDEO
  FLOOR_PLAN
  BROCHURE
  OTHER
}

model Property {
  id                   String                @id @default(uuid())
  isDraft              Boolean               @default(false)
  isArchived           Boolean               @default(false)
  showInWebsite        Boolean               @default(false)
  isBestProperty       Boolean               @default(false)
  archivedAt           DateTime?

  // Mandatory listing fields
  propertyType         PropertyType          @default(FLAT)
  societyBuildingName  String
  locationArea         String
  pincode              String
  city                 String                @default("Mumbai")
  floorNumber          Int?
  totalFloors          Int?
  bedrooms             Int?
  bathrooms            Int?
  balconies            Int?
  carpetAreaSqFt       Float
  superBuiltUpAreaSqFt Float?
  pricingType          PropertyPricingType   @default(SALE)
  askingPrice          Float
  availabilityStatus   PropertyListingStatus @default(AVAILABLE)
  availabilityDate     DateTime?

  // Access & Contact details
  accessType           PropertyAccessType    @default(DIRECT)
  ownerId              String?
  brokerId             String?               // Foreign key to Broker (nullable, reassignable)
  sourcePartnerId      String                // Foreign key to User (Partner who added listing)

  // Society Insights sub-section
  builderName          String?
  yearOfConstruction   Int?
  totalUnits           Int?
  amenities            String[]              @default([]) // e.g. ["parking", "gym", "lift", "security", "power_backup"]
  reraNumber           String?

  // Additional details
  notes                String?

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  // Relations
  sourcePartner        User                  @relation("PropertySourcePartner", fields: [sourcePartnerId], references: [id], onDelete: Restrict)
  owner                Owner?                @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: SetNull)
  broker               Broker?               @relation("BrokerProperties", fields: [brokerId], references: [id], onDelete: SetNull)
  media                PropertyMedia[]
  auditLogs            PropertyAuditLog[]
  clientShortlists     ClientShortlistedProperty[]
  websiteClicks        WebsitePropertyClick[]
  tasks                Task[]                      @relation("PropertyTasks")
  financeTransactions  FinanceTransaction[]
  upcomingFinanceItems UpcomingFinanceItem[]

  @@index([propertyType])
  @@index([availabilityStatus])
  @@index([sourcePartnerId])
  @@index([ownerId])
  @@index([brokerId])
  @@index([locationArea])
  @@index([pincode])
  @@index([isDraft])
  @@index([isArchived])
  @@index([showInWebsite])
  @@index([isBestProperty])
  @@map("properties")
}

model PropertyMedia {
  id           String                @id @default(uuid())
  propertyId   String
  category     PropertyMediaCategory @default(PHOTOGRAPH)
  title        String?
  key          String                // R2 storage key (for deletion/management)
  url          String                // Public CDN URL (for display)
  thumbnailUrl String?               // Video/PDF preview thumbnail if applicable
  mimeType     String
  sizeBytes    Int
  order        Int                   @default(0)
  isCover      Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  property     Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  clientShares ClientPropertyShareMedia[]

  @@unique([id, propertyId])

  @@index([propertyId])
  @@index([category])
  @@map("property_media")
}

model PropertyAuditLog {
  id          String   @id @default(uuid())
  propertyId  String
  userId      String
  action      String   // e.g. "CREATED", "UPDATED", "STATUS_CHANGE", "MEDIA_ADDED", "MEDIA_REMOVED", "ARCHIVED", "RESTORED"
  description String?
  changes     Json?    // Diffs of old vs new values
  createdAt   DateTime @default(now())

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user        User     @relation("PropertyAuditPartner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([userId])
  @@index([createdAt])
  @@map("property_audit_logs")
}

model PropertyFilterPreset {
  id        String   @id @default(uuid())
  userId    String
  name      String   // e.g. "Bandra 2-3BHK under 4 Cr"
  filters   Json     // JSON object storing applied filters
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("property_filter_presets")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String   // e.g. "LOGIN", "LOGOUT", "CREATE_EMPLOYEE", "UPDATE_EMPLOYEE", "RESET_PASSWORD", "VIEW_DOCUMENT", "CREATE", "UPDATE", "DELETE", "ACCESS_DENIED"
  module       String   // e.g. "EMPLOYEES", "PROPERTIES", "CLIENTS", "BROKERS", "OWNERS", "FINANCE", "DOCUMENTS", "AUTH"
  resourceId   String?
  resourceName String?
  details      String?
  changes      Json?    // Structured diff: [{ field, label, from, to }]
  deviceType   String?  // "DESKTOP" | "MOBILE" | "TABLET" | "UNKNOWN"
  deviceName   String?  // e.g. "Laptop (Windows • Chrome)" or "Phone (Android • Chrome)"
  city         String?  // e.g. "Mumbai"
  country      String?  // e.g. "IN"
  ipAddress    String?
  userAgent    String?
  status       String   @default("SUCCESS") // "SUCCESS" | "DENIED"
  createdAt    DateTime @default(now())

  user         User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([deviceType])
  @@index([createdAt])
  @@map("audit_logs")
}

model WebsitePropertyClick {
  id         String      @id @default(uuid())
  userId     String
  propertyId String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user       WebsiteUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@index([createdAt])
  @@map("website_property_clicks")
}

model Notification {
  id                 String    @id @default(uuid())
  userId             String?   // Target employee ID (for direct 1-to-1 alerts)
  requiredPermission String?   // e.g. "audit:read", "clients:read", "finance:read" (null = open broadcast)
  targetRole         String?   // Optional legacy role target or null
  title              String
  message            String
  type               String    // "NEW_ENQUIRY" | "LEAD_ASSIGNED" | "SHARE_VIEWED" | "SECURITY_ALERT" | "CLIENT_UPDATE" | "SYSTEM"
  link               String?   // Direct navigation URL (e.g. "/dashboard/clients?id=...")
  isRead             Boolean   @default(false)
  readAt             DateTime?
  metadata           Json?     // Optional payload (clientId, propertyId, enquiryId)
  createdAt          DateTime  @default(now())

  user               User?     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([requiredPermission])
  @@index([targetRole])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ==========================================
// TASK MANAGEMENT & CALENDAR INTEGRATION
// ==========================================

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskCategory {
  CLIENT_MEETING
  SITE_VISIT
  DOCUMENT_WORK
  ADMIN
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id             String       @id @default(uuid())
  title          String
  description    String?
  dueDate        DateTime
  priority       TaskPriority @default(MEDIUM)
  category       TaskCategory @default(OTHER)
  status         TaskStatus   @default(TODO)

  // Creator & Completer
  createdById    String
  createdBy      User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  completedById  String?
  completedBy    User?        @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt    DateTime?

  // Relational context
  clientId       String?
  client         Client?      @relation("ClientTasks", fields: [clientId], references: [id], onDelete: SetNull)

  propertyId     String?
  property       Property?    @relation("PropertyTasks", fields: [propertyId], references: [id], onDelete: SetNull)

  // Master Google Calendar integration (dreamkeykol.com master calendar)
  googleEventId  String?
  googleSyncedAt DateTime?

  // Assignees
  assignees      TaskAssignee[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([priority])
  @@index([category])
  @@index([createdById])
  @@index([completedAt])
  @@index([clientId])
  @@index([propertyId])
  @@index([googleEventId])
  @@map("tasks")
}

model TaskAssignee {
  taskId         String
  userId         String
  assignedAt     DateTime     @default(now())
  reminderSentAt DateTime?

  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User         @relation("TaskAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId, taskId])
  @@index([reminderSentAt])
  @@map("task_assignees")
}

model OrganizationCalendarConfig {
  id              String    @id @default("dreamkey-master")
  connectedEmail  String    @default("info@dreamkeykol.com")
  calendarId      String    @default("primary")
  refreshToken    String?
  accessToken     String?
  tokenExpiry     DateTime?
  syncEnabled     Boolean   @default(true)
  masterFeedToken String    @unique @default(uuid())
  lastSyncedAt    DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("organization_calendar_configs")
}

// ==========================================
// 3.9 FINANCE & REVENUE MODULE
// ==========================================

enum FinanceTransactionType {
  INCOME
  EXPENSE
}

enum IncomeCategory {
  BROKERAGE_RECEIVED
  RENTAL_COMMISSION
  SALE_COMMISSION
  CONSULTATION_FEES
  OTHER_INCOME
}

enum ExpenseCategory {
  OFFICE_RENT
  MARKETING
  TRAVEL_FUEL
  SALARY
  UTILITIES
  LEGAL_PROFESSIONAL
  OFFICE_SUPPLIES
  MISCELLANEOUS
}

enum PaymentMode {
  BANK_TRANSFER
  UPI
  CHEQUE
  CASH
  DEMAND_DRAFT
  OTHER
}

enum ForecastStatus {
  PENDING
  RECEIVED
  PAID
  CANCELLED
}

enum DueAdvanceType {
  RECEIVABLE       // Money owed to company (e.g. pending brokerage invoice)
  PAYABLE          // Money company owes (e.g. vendor dues, co-broker split)
  ADVANCE_GIVEN    // Advance paid by company (e.g. employee salary advance, builder deposit)
  ADVANCE_RECEIVED // Advance retainer/token received by company
}

enum DueAdvanceStatus {
  PENDING
  PARTIALLY_SETTLED
  SETTLED
  WRITTEN_OFF
}

model FinanceTransaction {
  id              String                 @id @default(uuid())
  type            FinanceTransactionType
  incomeCategory  IncomeCategory?
  expenseCategory ExpenseCategory?
  amount          Float
  transactionDate DateTime
  paymentMode     PaymentMode            @default(BANK_TRANSFER)
  referenceNumber String?                // UTR, Cheque No, Transaction Ref
  description     String?
  receiptUrl      String?

  // Attribution & Linking
  partnerId       String?                // Partner receiving income or paying expense
  partner         User?                  @relation("TransactionPartner", fields: [partnerId], references: [id], onDelete: SetNull)

  propertyId      String?
  property        Property?              @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  clientId        String?
  client          Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdById     String
  createdBy       User                   @relation("TransactionCreator", fields: [createdById], references: [id], onDelete: Cascade)

  // Salary link if created via salary disbursement
  salaryDisbursement SalaryDisbursement?

  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([type, transactionDate])
  @@index([partnerId])
  @@index([propertyId])
  @@index([clientId])
  @@map("finance_transactions")
}

model SalaryDisbursement {
  id              String              @id @default(uuid())
  employeeId      String
  employee        User                @relation("SalaryEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  month           Int                 // 1 - 12
  year            Int                 // e.g. 2026
  baseSalary      Float
  bonusIncentive  Float               @default(0)
  deductions      Float               @default(0)
  netPaid         Float
  paymentDate     DateTime
  paymentMode     PaymentMode         @default(BANK_TRANSFER)
  referenceNumber String?
  notes           String?

  transactionId   String?             @unique
  transaction     FinanceTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  disbursedById   String
  disbursedBy     User                @relation("SalaryDisburser", fields: [disbursedById], references: [id], onDelete: Cascade)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([employeeId, month, year])
  @@index([year, month])
  @@map("salary_disbursements")
}

model UpcomingFinanceItem {
  id              String                 @id @default(uuid())
  type            FinanceTransactionType // INCOME (expected commission) or EXPENSE (scheduled cost)
  category        String                 // Category string matching Income/Expense enum
  title           String                 // e.g. "South City flat closing commission"
  expectedAmount  Float
  expectedDate    DateTime
  status          ForecastStatus         @default(PENDING)
  notes           String?

  propertyId      String?
  property        Property?              @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  clientId        String?
  client          Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)

  partnerId       String?
  partner         User?                  @relation("ForecastPartner", fields: [partnerId], references: [id], onDelete: SetNull)

  createdById     String
  createdBy       User                   @relation("ForecastCreator", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([type, status, expectedDate])
  @@map("upcoming_finance_items")
}

model DueAndAdvanceRecord {
  id              String           @id @default(uuid())
  type            DueAdvanceType
  partyName       String           // Name of client, broker, vendor, or employee
  partyType       String           // "CLIENT" | "BROKER" | "OWNER" | "EMPLOYEE" | "VENDOR" | "OTHER"
  totalAmount     Float
  settledAmount   Float            @default(0)
  remainingAmount Float            // totalAmount - settledAmount
  dueDate         DateTime?
  status          DueAdvanceStatus @default(PENDING)
  notes           String?

  clientId        String?
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)

  brokerId        String?
  broker          Broker?          @relation(fields: [brokerId], references: [id], onDelete: SetNull)

  ownerId         String?
  owner           Owner?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  employeeId      String?
  employee        User?            @relation("DueAdvanceEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  createdById     String
  createdBy       User             @relation("DueAdvanceCreator", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([type, status])
  @@map("dues_and_advances")
}



