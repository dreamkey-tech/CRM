generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String?
  passwordHash String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles                 UserRole[]
  sessions              Session[]
  owners                Owner[]                @relation("OwnerPrimaryPartner")
  ownersCreated         Owner[]                @relation("OwnerCreator")
  brokers               Broker[]               @relation("BrokerPrimaryPartner")
  propertiesAdded       Property[]             @relation("PropertySourcePartner")
  propertyAuditLogs     PropertyAuditLog[]     @relation("PropertyAuditPartner")
  propertyFilterPresets PropertyFilterPreset[]
  clientsCreated        Client[]                    @relation("ClientCreator")
  clientAssignments     ClientPartnerAssignment[]   @relation("ClientAssignedPartner")
  clientAssignmentsMade ClientPartnerAssignment[]   @relation("ClientAssignmentCreator")
  clientShortlistsAdded  ClientShortlistedProperty[] @relation("ClientShortlistCreator")
  clientSharesCreated   ClientPropertyShare[]       @relation("ClientShareCreator")
  clientDocumentsAdded  ClientDocument[]            @relation("ClientDocumentUploader")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique // e.g. "leads:read", "leads:create", "deals:delete", "users:manage", "*:*"
  category    String           // e.g. "LEADS", "DEALS", "SETTINGS", "USERS", "ALL"
  description String?
  createdAt   DateTime         @default(now())

  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model WebsiteUser {
  id               String               @id @default(uuid())
  email            String               @unique
  name             String?
  emailVerified    Boolean              @default(false)
  passwordHash     String?              // Nullable for users registered solely via Google
  authProvider     String               @default("EMAIL") // "EMAIL" | "GOOGLE" | "BOTH"
  lastAuthProvider String?              @default("EMAIL")
  googleId         String?
  isActive         Boolean              @default(true)
  loginCount       Int                  @default(0)
  lastLoginAt      DateTime?
  lastActiveAt     DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  sessions         WebsiteUserSession[]

  @@index([googleId])
  @@map("website_users")
}

model WebsiteUserSession {
  id         String      @id @default(uuid())
  userId     String
  token      String      @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime    @default(now())
  lastUsedAt DateTime    @default(now())

  user       WebsiteUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("website_user_sessions")
}

model WebsiteEnquiry {
  id                   String   @id @default(uuid())
  fullName             String
  mobileNo             String
  email                String
  propertyType         String
  preferredLocation    String
  estimatedBudgetBand  String
  specificRequirements String?
  status               String   @default("NEW") // "NEW" | "IN_PROGRESS" | "CONTACTED" | "RESOLVED" | "CLOSED"
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([email])
  @@index([mobileNo])
  @@index([status])
  @@map("website_enquiries")
}

enum BrokerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Broker {
  id                      String       @id @default(uuid())
  name                    String
  phone                   String?
  email                   String?
  whatsappNumber          String?
  areaOfOperation         String?
  primaryContactPartnerId String?
  minDealValue            Float?       // Minimum deal value typically handled
  societyExpertise        String[]     @default([]) // List of societies or localities where broker has strong connections
  status                  BrokerStatus @default(ACTIVE)
  notes                   String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  primaryContactPartner   User?        @relation("BrokerPrimaryPartner", fields: [primaryContactPartnerId], references: [id], onDelete: SetNull)
  properties              Property[]   @relation("BrokerProperties")

  @@index([status])
  @@index([phone])
  @@index([email])
  @@index([primaryContactPartnerId])
  @@map("brokers")
}

enum OwnerStatus {
  ACTIVE
  INACTIVE
}

model Owner {
  id                      String      @id @default(uuid())
  name                    String
  phone                   String
  email                   String?
  whatsappNumber          String?
  address                 String?
  primaryContactPartnerId String?
  createdById             String
  notes                   String?
  status                  OwnerStatus @default(ACTIVE)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  primaryContactPartner User?      @relation("OwnerPrimaryPartner", fields: [primaryContactPartnerId], references: [id], onDelete: SetNull)
  createdBy             User       @relation("OwnerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  properties            Property[] @relation("OwnerProperties")

  @@index([phone])
  @@index([status])
  @@index([primaryContactPartnerId])
  @@index([createdById])
  @@map("owners")
}

// ==========================================
// CLIENT DIRECTORY (V1 — no lead pipeline yet)
// ==========================================

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum ClientShortlistStatus {
  SHORTLISTED
  SHARED
  VISITED
  INTERESTED
  NOT_INTERESTED
}

enum ClientShareChannel {
  WHATSAPP
  EMAIL
  LINK
}

enum ClientShareStatus {
  PREPARED
  COMPOSER_OPENED
  SENT_CONFIRMED
}

enum ClientDocumentCategory {
  AADHAAR
  PAYMENT_RECEIPT
  CLIENT_DOCUMENT
  PCC_APPLICATION
  CERTIFICATE
  KYC
}

model Client {
  id             String       @id @default(uuid())
  name           String
  phone          String
  email          String?
  whatsappNumber String?
  address        String?
  notes          String?
  status         ClientStatus @default(ACTIVE)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  createdBy             User                        @relation("ClientCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedPartners      ClientPartnerAssignment[]
  shortlistedProperties ClientShortlistedProperty[]
  documents             ClientDocument[]

  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@map("clients")
}

model ClientPartnerAssignment {
  clientId     String
  partnerId    String
  assignedById String
  assignedAt   DateTime @default(now())

  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  partner    User   @relation("ClientAssignedPartner", fields: [partnerId], references: [id], onDelete: Restrict)
  assignedBy User   @relation("ClientAssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)

  @@id([clientId, partnerId])
  @@index([partnerId, clientId])
  @@index([assignedById])
  @@map("client_partner_assignments")
}

model ClientShortlistedProperty {
  id         String                @id @default(uuid())
  clientId   String
  propertyId String
  status     ClientShortlistStatus @default(SHORTLISTED)
  notes      String?
  addedById  String
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  client   Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  property Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  addedBy  User                  @relation("ClientShortlistCreator", fields: [addedById], references: [id], onDelete: Restrict)
  shares   ClientPropertyShare[]

  @@unique([clientId, propertyId])
  @@unique([id, clientId, propertyId])
  @@index([propertyId])
  @@index([clientId, status])
  @@index([addedById])
  @@map("client_shortlisted_properties")
}

model ClientPropertyShare {
  id                    String             @id @default(uuid())
  shortlistedPropertyId String
  clientId              String
  propertyId            String
  // Generate a cryptographically random token on the server, never from a client ID.
  publicToken           String             @unique
  channel               ClientShareChannel
  status                ClientShareStatus  @default(PREPARED)
  recipient             String?
  subject               String?
  message               String
  // Whitelisted public listing fields only; never serialize a full Property/Client.
  propertySnapshot      Json
  // Historical selection metadata only, without URLs; public pages use live media relations.
  selectedMediaSnapshot Json
  createdById           String
  composerOpenedAt      DateTime?
  sentConfirmedAt       DateTime?
  expiresAt             DateTime?
  revokedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  shortlistedProperty ClientShortlistedProperty  @relation(fields: [shortlistedPropertyId, clientId, propertyId], references: [id, clientId, propertyId], onDelete: Restrict)
  createdBy           User                       @relation("ClientShareCreator", fields: [createdById], references: [id], onDelete: Restrict)
  selectedMedia       ClientPropertyShareMedia[]

  @@unique([id, propertyId])
  @@index([clientId, createdAt])
  @@index([propertyId])
  @@index([shortlistedPropertyId, clientId, propertyId])
  @@index([createdById])
  @@map("client_property_shares")
}

model ClientPropertyShareMedia {
  shareId         String
  propertyMediaId String
  propertyId      String
  order           Int    @default(0)

  // Composite references prevent selecting media from a different property.
  share ClientPropertyShare @relation(fields: [shareId, propertyId], references: [id, propertyId], onDelete: Cascade)
  media PropertyMedia       @relation(fields: [propertyMediaId, propertyId], references: [id, propertyId], onDelete: Cascade)

  @@id([shareId, propertyMediaId])
  @@index([shareId, propertyId])
  @@index([propertyMediaId, propertyId])
  @@map("client_property_share_media")
}

model ClientDocument {
  id           String                 @id @default(uuid())
  clientId     String
  category     ClientDocumentCategory
  title        String?
  originalName String
  // Store in a private bucket. A prefix within the public property bucket is not private.
  key          String                 @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  client     Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  uploadedBy User   @relation("ClientDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([clientId, category])
  @@index([uploadedById])
  @@map("client_documents")
}

// ==========================================
// PROPERTY & MEDIA SCHEMA
// ==========================================

enum PropertyType {
  FLAT
  LAND
  WAREHOUSE
  COMMERCIAL
  OTHER
}

enum PropertyPricingType {
  SALE
  RENT
}

enum PropertyListingStatus {
  AVAILABLE
  UNDER_NEGOTIATION
  TOKEN_PAID
  DEAL_DONE
  RENTED_OUT
  SOLD
  UPCOMING
}

enum PropertyAccessType {
  DIRECT
  BROKER // "+1 Broker"
}

enum PropertyMediaCategory {
  PHOTOGRAPH
  VIDEO
  FLOOR_PLAN
  BROCHURE
  OTHER
}

model Property {
  id                   String                @id @default(uuid())
  isDraft              Boolean               @default(false)
  isArchived           Boolean               @default(false)
  archivedAt           DateTime?

  // Mandatory listing fields
  propertyType         PropertyType          @default(FLAT)
  societyBuildingName  String
  locationArea         String
  pincode              String
  city                 String                @default("Mumbai")
  floorNumber          Int?
  totalFloors          Int?
  bedrooms             Int?
  bathrooms            Int?
  balconies            Int?
  carpetAreaSqFt       Float
  superBuiltUpAreaSqFt Float?
  pricingType          PropertyPricingType   @default(SALE)
  askingPrice          Float
  availabilityStatus   PropertyListingStatus @default(AVAILABLE)
  availabilityDate     DateTime?

  // Access & Contact details
  accessType           PropertyAccessType    @default(DIRECT)
  ownerId              String?
  brokerId             String?               // Foreign key to Broker (nullable, reassignable)
  sourcePartnerId      String                // Foreign key to User (Partner who added listing)

  // Society Insights sub-section
  builderName          String?
  yearOfConstruction   Int?
  totalUnits           Int?
  amenities            String[]              @default([]) // e.g. ["parking", "gym", "lift", "security", "power_backup"]
  reraNumber           String?

  // Additional details
  notes                String?

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  // Relations
  sourcePartner        User                  @relation("PropertySourcePartner", fields: [sourcePartnerId], references: [id], onDelete: Restrict)
  owner                Owner?                @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: SetNull)
  broker               Broker?               @relation("BrokerProperties", fields: [brokerId], references: [id], onDelete: SetNull)
  media                PropertyMedia[]
  auditLogs            PropertyAuditLog[]
  clientShortlists     ClientShortlistedProperty[]

  @@index([propertyType])
  @@index([availabilityStatus])
  @@index([sourcePartnerId])
  @@index([ownerId])
  @@index([brokerId])
  @@index([locationArea])
  @@index([pincode])
  @@index([isDraft])
  @@index([isArchived])
  @@map("properties")
}

model PropertyMedia {
  id           String                @id @default(uuid())
  propertyId   String
  category     PropertyMediaCategory @default(PHOTOGRAPH)
  title        String?
  key          String                // R2 storage key (for deletion/management)
  url          String                // Public CDN URL (for display)
  thumbnailUrl String?               // Video/PDF preview thumbnail if applicable
  mimeType     String
  sizeBytes    Int
  order        Int                   @default(0)
  isCover      Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  property     Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  clientShares ClientPropertyShareMedia[]

  @@unique([id, propertyId])

  @@index([propertyId])
  @@index([category])
  @@map("property_media")
}

model PropertyAuditLog {
  id          String   @id @default(uuid())
  propertyId  String
  userId      String
  action      String   // e.g. "CREATED", "UPDATED", "STATUS_CHANGE", "MEDIA_ADDED", "MEDIA_REMOVED", "ARCHIVED", "RESTORED"
  description String?
  changes     Json?    // Diffs of old vs new values
  createdAt   DateTime @default(now())

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user        User     @relation("PropertyAuditPartner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([userId])
  @@index([createdAt])
  @@map("property_audit_logs")
}

model PropertyFilterPreset {
  id        String   @id @default(uuid())
  userId    String
  name      String   // e.g. "Bandra 2-3BHK under 4 Cr"
  filters   Json     // JSON object storing applied filters
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("property_filter_presets")
}


